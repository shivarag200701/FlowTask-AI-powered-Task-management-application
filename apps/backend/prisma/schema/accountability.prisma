model AccountabilitySnapshot {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshotDate      String   // YYYY-MM-DD
  totalTasksDue     Int      @default(0)
  tasksCompleted    Int      @default(0)
  tasksCompletedLate Int     @default(0)
  tasksNotCompleted Int      @default(0)
  tasksCarriedOver  Int      @default(0)
  tagBreakdown      Json?
  projectBreakdown  Json?
  dayOfWeek         Int      // 0=Sun, 1=Mon, ...6=Sat
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, snapshotDate])
  @@index([userId])
}

model WeeklyInsight {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStartDate        String
  weekEndDate          String
  overallCompletionRate Float   @default(0)
  previousWeekRate     Float?
  trend                String   @default("STABLE") // "IMPROVING" | "DECLINING" | "STABLE"
  mostProductiveDay    String?
  leastProductiveDay   String?
  problematicTags      Json?
  problematicProjects  Json?
  summary              String   @db.Text
  readAt               DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@index([userId, weekStartDate])
}
