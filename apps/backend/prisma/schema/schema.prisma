// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id                String             @id @default(cuid())
  name              String?          
  email             String?          @unique
  hashedPassword    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  todos             Todo[]
  isPasswordSet     Boolean         @default(false)
  emailVerified     DateTime?        
  image             String?

  oauthAccounts     OAuthAccount[]
  preference        UserPrefrence?
  notfications      Notifications[]
  tags              Tag[]
  
  projects          Project[]

  createdWorkspaces Workspace[]   @relation("CreatedWorkspaces")
  memberships       WorkspaceMember[]

  firstDashboardVisited Boolean   @default(false)

  accountabilitySessions   AccountabilitySession[]
  accountabilitySnapshots  AccountabilitySnapshot[]
  weeklyInsights           WeeklyInsight[]
}




model UserPrefrence {
  id            String             @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String      @unique

  // Notifications Channel preferences
  emailEnabled    Boolean @default(true)
  smsEnabled      Boolean @default(true)
  pushEnabled     Boolean @default(true)
  inAppEnabled    Boolean @default(true)


  taskDisplayPreferences    Json?


  //notification remainders
  taskRemainders  Boolean @default(true)

  //Timing preferences
  automaticRemainder Boolean @default(true)
  reminderBefore  Int     @default(30) //miutes before due time
  dailyDigest     Boolean  @default(false)
  digestTime      String?  // "09:00" for 9 AM

  // Contact info
  phoneNumber     String?
  pushToken       String?  // FCM token for mobile

  // Accountability preferences
  accountabilityEnabled     Boolean @default(true)
  dailyStandupTime          String? // "09:00" format
  weeklyInsightDay          Int     @default(1) // 0=Sun, 1=Mon
  accountabilityTone        String  @default("supportive") // "supportive" | "direct" | "tough"

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

}






