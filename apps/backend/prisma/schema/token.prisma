//OTP for email verification
model EmailVerificationToken {
  identifier      String
  token           String  @unique
  expires         DateTime

  @@unique([identifier,token])
}

//email invites
model verificationToken {
  identifier      String
  token           String  @unique
  expires         DateTime 

  //when used for email invites for workspaces
  workspaceId     String?

  @@unique([identifier, token]) 
}