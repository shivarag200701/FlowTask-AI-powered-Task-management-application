  "keyFeatures": [
    "Task creation with priorities, due dates, colors, and reminders",
    "Project organization with list and board (Kanban) views",
    "Tag-based task categorization and filtering",
    "Today, Upcoming, and Completed smart views",
    "Subtask support for hierarchical task breakdown",
    "Full-text search powered by Meilisearch",
    "Drag-and-drop task reordering and Kanban board",
    "Email OTP and Google OAuth authentication",
    "Dark and light theme support",
    "Keyboard shortcuts for power users",
    "Email reminders for due tasks",
    "Natural language date input (e.g., 'tomorrow', 'next Monday')"
  ],
