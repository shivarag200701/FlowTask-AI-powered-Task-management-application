model Project{
    id                  String           @id @default(cuid())
    name                String
    slug                String?           @unique
    personal            Boolean          @default(false)
    userId              String
    user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

    //Need to implement an Database level or application level check that a project can either be users personal project or related to an workspace and cannot be alone
    workSpaceId         String?
    todos               Todo[]

    taskDisplayPreferences    Json?
}